{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laranail/authkit-social",
    "type": "library",
    "description": "Social login for laranail/authkit: Socialite-backed providers, identity linking and account provisioning.",
    "keywords": [
        "laravel",
        "authentication",
        "authkit",
        "social-login",
        "socialite",
        "oauth",
        "google"
    ],
    "license": "MIT",
    "homepage": "https://opensource.simtabi.com/products/laranail/authkit-social",
    "authors": [
        {
            "name": "Simtabi",
            "email": "hello@simtabi.com"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/authkit-social/issues",
        "source": "https://github.com/laranail/authkit-social",
        "docs": "https://opensource.simtabi.com/documentation/laranail/authkit-social/"
    },
    "require": {
        "php": "^8.4.1 || ^8.5",
        "laranail/authkit": "^0.1",
        "laranail/enumerator": "^0.1",
        "laranail/package-tools": "^0.1",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.0",
        "socialiteproviders/apple": "^5.10 || ^6.0",
        "socialiteproviders/manager": "^4.10"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\AuthKit\\Social\\": "src/",
            "Simtabi\\Laranail\\AuthKit\\Social\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\AuthKit\\Social\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\AuthKit\\Social\\Providers\\SocialServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/authkit.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/enumerator.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/captcha.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/db-tools.git"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ],
    "scripts": {
        "format": "@pint-fix",
        "test": [
            "vendor/bin/pest --parallel"
        ],
        "lint": [
            "@pint"
        ],
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/.github",
            "/.gitignore",
            "phpunit.xml",
            "pint.json",
            "testbench.yaml"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
